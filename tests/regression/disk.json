{
  "description": "The SD2PET: the test disk (pet_test_disk's, a copy of its own in disk-rw) entered, listed on the screen, its first program run, and a program saved into the image.",
  "steps": [
    {
      "method": "disk.card",
      "params": {
        "path": "disk-rw"
      }
    },
    {
      "method": "emu.run_until",
      "params": {
        "screen_contains": "READY."
      }
    },
    {
      "method": "disk.command",
      "params": {
        "command": "cd:hello.d64"
      }
    },
    {
      "method": "input.type",
      "params": {
        "text": "load\"$\",8\nlist\n"
      }
    },
    {
      "method": "emu.run_frames",
      "params": {
        "count": 120
      }
    },
    {
      "checkpoint": "listed"
    },
    {
      "method": "disk.run",
      "params": {}
    },
    {
      "method": "emu.run_frames",
      "params": {
        "count": 30
      }
    },
    {
      "checkpoint": "ran"
    },
    {
      "method": "input.type",
      "params": {
        "text": "save\"@:copy\",8\nload\"$\",8\nlist\n"
      }
    },
    {
      "method": "emu.run_frames",
      "params": {
        "count": 300
      }
    },
    {
      "checkpoint": "saved"
    }
  ],
