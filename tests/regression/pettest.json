      "params": {
        "path": "../../../../PETTest/irqcost.d64"
      }
    },
    {
      "method": "emu.run_frames",
      "params": {
        "count": 600
      }
    },
    {
      "checkpoint": "irqcost"
    },
    {
      "method": "emu.reset",
      "params": {
        "power": true
      }
    },
    {
      "method": "disk.run",
      "params": {
        "path": "../../../../PETTest/bench-inline.d64"
      }
    },
    {
      "method": "emu.run_until",
      "params": {
        "screen_contains": "SMAX",
